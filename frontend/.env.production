# Leave VITE_API_URL empty to use host-relative API routes (/api)
VITE_API_URL=

# PRODUCTION: Set VITE_ADMIN_EMAIL and VITE_ADMIN_PASSWORD as Secret Environment
# Variables in your hosting platform (Render Dashboard > Environment).
# DO NOT put production credentials here — this file is committed to git.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
