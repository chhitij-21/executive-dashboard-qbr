# Service Account Credentials for Auto-Login
SERVICE_USER=svc_dashboard
SERVICE_PASS=SuperSecret123
PPT_SCREENSHOT_PATH=tmp/summary.png

# Authentication & Session Management (Item #4)
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars-long
AUTH_V2=true
REDIS_URL=redis://localhost:6379

# Data Encryption at Rest (Item #3)
RECIPIENTS_ENCRYPTION_KEY=your-64-char-hex-master-encryption-key-here-32-bytes

# Leave VITE_API_URL empty for host-relative API routing (/api)
VITE_API_URL=

# Cisco PSIRT openVuln API v2 Credentials
CISCO_CLIENT_ID=your_cisco_client_id_here
CISCO_CLIENT_SECRET=your_cisco_client_secret_here

TURSO_DATABASE_URL=libsql://tumhara-db-url-yahan
TURSO_AUTH_TOKEN=tumhara-lamba-token-yahan
