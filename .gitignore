# Dependencies — never commit
node_modules/
frontend/node_modules/

# Build Output — Render builds this fresh on every deploy
frontend/dist/
dist/
build/

# Generated Reports (runtime output)
reports/
tmp/
templates/extracted_media/

# Runtime Uploads (ephemeral)
data/incoming/

# Runtime history (regenerated at runtime)
data/reports_metadata.json

# Keep seed data — clients.json needed on first boot
!data/clients.json

# Customer Files — never commit
*.xlsx
*.xls
*.csv

# Environment Variables
.env
.env.local
.env.*.local

# Logs
*.log

# OS Files
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Vercel (not needed for Render)
.vercel
vercel.json
api/

# Python
__pycache__/
*.py[cod]
