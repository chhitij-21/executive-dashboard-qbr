# Dependencies — never commit
node_modules/
frontend/node_modules/

# Build Output — Render builds this fresh on every deploy
frontend/dist/
dist/
build/

# Generated Reports (runtime output)
reports/
tmp/
templates/extracted_media/

# Runtime Uploads (ephemeral)
data/incoming/

# Runtime history (regenerated at runtime)
data/reports_metadata.json

# Keep seed data — clients.json needed on first boot
!data/clients.json

# Customer Files — never commit
*.xlsx
*.xls
*.csv

# Environment Variables
.env
.env.local
.env.*.local
frontend/.env          # contains local dev credentials — never commit
# NOTE: .env.production is committed but contains ONLY empty placeholders.
#       Set VITE_ADMIN_EMAIL, VITE_ADMIN_PASSWORD, ADMIN_PASSWORD in the
#       Render Dashboard (Environment > Secret Files) — never in committed files.
# NOTE: .env.local contains VERCEL_OIDC_TOKEN — verify it is not in git history:
#       git log --all --oneline -- .env.local


# Logs
*.log

# OS Files
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Vercel (not needed for Render)
.vercel
vercel.json
api/

# Python
__pycache__/
*.py[cod]
