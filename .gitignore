# Dependencies
node_modules/

# Build Output
frontend/dist/
dist/
build/

# Generated Reports (runtime output — never commit)
reports/

# Runtime Uploads (ephemeral — never commit)
data/incoming/

# Keep seed data files (clients.json needed on first boot)
# data/clients.json is committed so Render has initial client config
!data/clients.json

# Customer Files (never commit)
*.xlsx
*.xls
*.csv

# Environment Variables
.env
.env.local
.env.*.local

# Logs
*.log

# OS Files
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Vercel
.vercel
vercel.json
api/

# Python Cache
__pycache__/
*.py[cod]
