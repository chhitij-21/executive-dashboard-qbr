{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["../shared/**/*.ts", "**/*.ts"],
  "exclude": ["node_modules", "../shared/dist"]
}
