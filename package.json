{
  "name": "executive-dashboard-qbr",
  "version": "1.0.0",
  "description": "Executive Dashboard and Automated QBR Generator",
  "main": "backend/index.js",
  "engines": {
    "node": ">=18.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "npm run build && node backend/index.js",
    "dev:backend": "node backend/index.js",
    "dev:frontend": "npx vite --config frontend/vite.config.js",
    "build": "cd frontend && npm install --include=dev && npm run build",
    "start": "node --max-old-space-size=460 backend/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pptxgenjs": "^3.12.0",
    "puppeteer": "^25.4.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.3.1"
  }
}
