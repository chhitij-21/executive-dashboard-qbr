        <div style="font-size: 14px; font-weight: 700; color: #0284c7; margin-top: 6px;">Device Power Issues</div>
      </div>
    </div>

    <div class="footer">
      <div>Confidential — Jubilant Foodworks Ltd (JFL) Executive Dashboard Report</div>
      <div>Generated on SSOT Engine: 2026-09-30</div>
    </div>
  </div>

